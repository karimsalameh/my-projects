#include <iostream>
#include <string>
#include <vector>

using namespace std;

string clean(string input) {
    string out = "";
    for (char c : input) {
        if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')) {
            if (c >= 'a' && c <= 'z') {
                out += (char)(c - 32); 
            } else {
                out += c;
            }
        }
    }
    return out;
}

vector<int> getOrder(string key) {
    vector<pair<char, int>> chars;
    for (int i = 0; i < key.length(); i++) {
        chars.push_back({key[i], i});
    }
    
    int n = chars.size();
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (chars[j].first > chars[j + 1].first) {
                pair<char, int> temp = chars[j];
                chars[j] = chars[j + 1];
                chars[j + 1] = temp;
            }
        }
    }
    
    vector<int> order(key.length());
    for (int i = 0; i < chars.size(); i++) {
        order[i] = chars[i].second;
    }
    return order;
}

vector<int> getInverse(vector<int> order) {
    vector<int> inv(order.size());
    for (int i = 0; i < order.size(); i++) {
        inv[order[i]] = i;
    }
    return inv;
}

string vEncrypt(string text, string key) {
    string res = "";
    int kLen = key.length();
    for (int i = 0; i < text.length(); i++) {
        res += (text[i] - 'A' + key[i % kLen] - 'A') % 26 + 'A';
    }
    return res;
}

string vDecrypt(string text, string key) {
    string res = "";
    int kLen = key.length();
    for (int i = 0; i < text.length(); i++) {
        res += (text[i] - key[i % kLen] + 26) % 26 + 'A';
    }
    return res;
}

string permute(string text, string rKey, string cKey, bool enc) {
    int R = rKey.length();
    int C = cKey.length();
    int block = R * C;
    
    if (enc) {
        while (text.length() % block != 0) text += 'X';
    }

    vector<int> rOrd = getOrder(rKey);
    vector<int> cOrd = getOrder(cKey);
    
    if (!enc) {
        rOrd = getInverse(rOrd);
        cOrd = getInverse(cOrd);
    }

    string res = "";
    
    for (int b = 0; b < text.length(); b += block) {
        vector<string> mat(R, string(C, ' '));
        vector<string> tmp(R, string(C, ' '));
        
        for (int r = 0; r < R; r++)
            for (int c = 0; c < C; c++)
                mat[r][c] = text[b + r * C + c];
        
        if (enc) {
            for (int r = 0; r < R; r++)
                for (int c = 0; c < C; c++)
                    tmp[r][c] = mat[r][cOrd[c]];
            for (int r = 0; r < R; r++)
                for (int c = 0; c < C; c++)
                    mat[r][c] = tmp[rOrd[r]][c];
        } else {
            for (int r = 0; r < R; r++)
                for (int c = 0; c < C; c++)
                    tmp[r][c] = mat[rOrd[r]][c];
            for (int r = 0; r < R; r++)
                for (int c = 0; c < C; c++)
                    mat[r][c] = tmp[r][cOrd[c]];
        }
        
        for (int r = 0; r < R; r++)
            for (int c = 0; c < C; c++)
                res += mat[r][c];
    }
    return res;
}

int main() {
    string modeStr, text, vKey, rKey, cKey;
    
    cout << "Select mode (E for Encrypt, D for Decrypt): ";
    getline(cin, modeStr);
    bool enc = (modeStr[0] == 'E' || modeStr[0] == 'e');
    
    cout << "Input target string: ";
    getline(cin, text);
    text = clean(text);
    
    cout << "Input Vigenere Secret Key: ";
    getline(cin, vKey);
    vKey = clean(vKey);
    
    cout << "Input Row Permutation Key: ";
    getline(cin, rKey);
    rKey = clean(rKey);
    
    cout << "Input Column Permutation Key: ";
    getline(cin, cKey);
    cKey = clean(cKey);
    
    if (vKey.empty() || rKey.empty() || cKey.empty()) return 1;

    if (enc) {
        string inter = vEncrypt(text, vKey);
        cout << "\nIntermediate: " << inter << "\n";
        cout << "Final: " << permute(inter, rKey, cKey, true) << "\n";
    } else {
        string inter = permute(text, rKey, cKey, false);
        cout << "\nIntermediate: " << inter << "\n";
        cout << "Final: " << vDecrypt(inter, vKey) << "\n";
    }

    return 0;
}
